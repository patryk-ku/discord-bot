{
	"name": "discord-bot",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "NODE_ENV=development nodemon index.js",
		"start": "NODE_ENV=production pnpm pm2 start index.js --name 'discord-bot' --log 'bot.log'",
		"restart": "pnpm pm2 restart 'discord-bot'",
		"reload": "pnpm pm2 reload 'discord-bot'",
		"stop": "pnpm pm2 delete 'discord-bot' && pnpm pm2 kill",
		"list": "pnpm pm2 ls",
		"monit": "pnpm pm2 monit",
		"logs": "pnpm pm2 logs 'discord-bot'",
		"deploy-commands": "node --no-deprecation ./scripts/deploy-commands.js",
		"deploy-global-commands": "node --no-deprecation ./scripts/deploy-global-commands.js",
		"reset-commands": "node ./scripts/reset-commands.js"
	},
	"keywords": [],
	"author": "Patryk Kurdziel",
	"license": "MIT",
	"dependencies": {
		"@distube/ytsr": "^2.0.4",
		"@napi-rs/canvas": "^0.1.80",
		"discord.js": "^14.24.0",
		"dotenv": "^17.2.3",
		"pm2": "^6.0.13",
		"sequelize": "^6.37.7",
		"sqlite3": "^5.1.7",
		"undici": "^7.16.0",
		"validator": "^13.15.15"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"nodemon": "^3.1.10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sqlite3"
		]
	}
}
